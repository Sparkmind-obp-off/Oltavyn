{
  "name": "oltavyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply oltavyn-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply oltavyn-production --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "test:smoke": "node tests/smoke.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name oltavyn"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "^3.90.0"
  }
}
